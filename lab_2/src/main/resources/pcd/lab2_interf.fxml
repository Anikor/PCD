<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox prefHeight="600.0" prefWidth="800.0" spacing="8.0" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="pcd.Controller">
   <children>
      <Label text="Structura firelor de execuție (varianta 4)" />
      <Label fx:id="formula" />
      <HBox spacing="8.0">
         <children>
            <Button fx:id="mediumButton" mnemonicParsing="false" onAction="#onMedium" text="Nivel mediu" />
            <Button fx:id="advancedButton" mnemonicParsing="false" onAction="#onAdvanced" text="Nivel avansat" />
         </children>
      </HBox>
      <Label text="Rezultate" />
      <TextArea fx:id="out" editable="false" VBox.vgrow="ALWAYS" />
   </children>
   <padding>
      <Insets bottom="10.0" left="10.0" right="10.0" top="10.0" />
   </padding>
</VBox>
