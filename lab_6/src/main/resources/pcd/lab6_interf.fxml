<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TitledPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox prefHeight="620.0" prefWidth="900.0" spacing="8.0" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="pcd.Controller">
   <children>
      <HBox alignment="CENTER_LEFT" spacing="8.0">
         <children>
            <Label text="Varianta 4: X = 3 producători, Y = 2 consumatori, Z = 66 obiecte în total, D = 11, consoane, câte 1 odată; umplere, apoi golire" />
            <Button fx:id="startButton" mnemonicParsing="false" onAction="#onStart" text="Start" />
         </children>
      </HBox>
      <Label fx:id="depotLabel" text="Depozit 0/11: []" />
      <HBox spacing="8.0" VBox.vgrow="ALWAYS">
         <children>
            <TitledPane collapsible="false" maxHeight="1.7976931348623157E308" text="Producători" HBox.hgrow="ALWAYS">
               <content>
                  <TextArea fx:id="producerArea" editable="false" wrapText="true" />
               </content>
            </TitledPane>
            <TitledPane collapsible="false" maxHeight="1.7976931348623157E308" text="Consumatori" HBox.hgrow="ALWAYS">
               <content>
                  <TextArea fx:id="consumerArea" editable="false" wrapText="true" />
               </content>
            </TitledPane>
         </children>
      </HBox>
   </children>
   <padding>
      <Insets bottom="10.0" left="10.0" right="10.0" top="10.0" />
   </padding>
</VBox>
